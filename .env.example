# Nusxa oling: .env.local  (bu fayl gitga tushmaydi)

# PostgreSQL. Lokal: `npm run db:start` aynan shu manzilda server ko'taradi
DATABASE_URL=postgres://postgres:postgres@localhost:5432/avtomaqola

# Kamida 32 belgili tasodifiy satr. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Saytning tashqi manzili (production'da https://...). Production build'da majburiy
APP_URL=http://localhost:3000

# Profil rasmlari va maqola PDF'lari papkasi. Production'da deploy'da o'chmaydigan absolyut yo'l
# STORAGE_DIR=/var/lib/avtomaqola/storage

# Telegram bot: @BotFather -> /newbot. Username "@"siz yoziladi, masalan: avtomaqola_bot
TELEGRAM_BOT_USERNAME=
# Token bo'sh qolsa, dev rejimida bot xabarlari (kodlar ham) server konsoliga chiqadi
TELEGRAM_BOT_TOKEN=
# Webhook so'rovlarini tekshirish uchun maxfiy satr: 1-256 belgi, faqat A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# AI yordamchi (Claude): https://platform.claude.com -> API keys. Bo'sh qolsa, muharrirda AI paneli ko'rinmaydi
ANTHROPIC_API_KEY=
