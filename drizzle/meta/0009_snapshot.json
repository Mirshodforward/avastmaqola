        "articles_license_valid": {
          "name": "articles_license_valid",
          "value": "\"articles\".\"license\" in ('cc-by-4.0', 'cc-by-nc-4.0', 'all-rights-reserved')"
        },
        "articles_venue_type_valid": {
          "name": "articles_venue_type_valid",
          "value": "\"articles\".\"venue_type\" in ('journal', 'conference')"
        },
        "articles_pub_year_valid": {
          "name": "articles_pub_year_valid",
          "value": "\"articles\".\"pub_year\" between 1900 and 2100"
        },
        "articles_doi_format": {
          "name": "articles_doi_format",
          "value": "\"articles\".\"doi\" ~ '^10[.][0-9]{4,9}/[^[:space:]]+$'"
        },
        "articles_complete_unless_editable": {
          "name": "articles_complete_unless_editable",
          "value": "\"articles\".\"status\" in ('draft', 'rejected') or (\"articles\".\"lang\" is not null and \"articles\".\"pdf_key\" is not null\n        and \"articles\".\"rights_confirmed_at\" is not null\n        and btrim(coalesce(\"articles\".\"title_uz\", '')) <> '' and btrim(coalesce(\"articles\".\"title_ru\", '')) <> '' and btrim(coalesce(\"articles\".\"title_en\", '')) <> ''\n        and btrim(coalesce(\"articles\".\"abstract_uz\", '')) <> '' and btrim(coalesce(\"articles\".\"abstract_ru\", '')) <> '' and btrim(coalesce(\"articles\".\"abstract_en\", '')) <> ''\n        and cardinality(\"articles\".\"keywords_uz\") > 0 and cardinality(\"articles\".\"keywords_ru\") > 0 and cardinality(\"articles\".\"keywords_en\") > 0)"
        },
        "articles_published_has_date": {
          "name": "articles_published_has_date",
          "value": "\"articles\".\"status\" <> 'published' or \"articles\".\"published_at\" is not null"
        }
      },
      "isRLSEnabled": false
    },
